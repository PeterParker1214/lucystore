{
  "name": "lucystore",
  "productName": "Lucy Store",
  "version": "1.6.0",
  "description": "Inventory, cash flow, utang and e-wallet manager for a sari-sari store.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ph.lucystore.app",
    "files": [
      "main.js",
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "vendor/**",
      "icons/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Lucy Store"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
